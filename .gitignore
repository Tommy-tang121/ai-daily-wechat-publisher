# 本地批处理文件（含本地路径和用户名，不上传）
# Legacy root batch files are ignored; tracked scripts live in app/scripts.
/*.bat

# 密钥环境变量（包含 API Key、Secret 等敏感信息）
.env
app/.env

# Agent 工作规则（个人使用，不上传）
AGENTS.md

# Git 隔离工作区（仅本地使用）
.worktrees/

# 临时测试脚本（_开头的 .py 文件）
_*.py

# Python
__pycache__/
*.pyc
*.pyo

# 生成的封面图片（可按需保留或取消注释）
# app/static/covers/

# 日志
app/logs/
*.log
app/data/*.db
app/data/*.db-shm
app/data/*.db-wal

# node_modules（发布 skill 的 npm 依赖，体积巨大）
node_modules/
app/vendor/*/scripts/node_modules/
